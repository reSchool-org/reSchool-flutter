# учётка eSchool, ей сервер проверяет пользователей
ESCHOOL_USERNAME=your_username
ESCHOOL_PASSWORD=your_password
# версию клиента обновляет actions и кладёт в последний релиз,
# переопределять нужно только если репозиторий свой
ESCHOOL_VERSION_URL=
ESCHOOL_VERSION_FALLBACK=8.1.0

# база данных, postgres
DB_HOST=db
DB_PORT=5432
DB_USER=reschool
DB_PASSWORD=change_me
DB_NAME=reschool
# строка DATABASE_URL перебивает поля выше, пригодится для внешней базы
# пример: postgresql://user:pass@host:5432/reschool
DATABASE_URL=

# кеш, redis
# нужен для горячих выборок, сессий eSchool и общих счётчиков рейт лимита
# если redis недоступен, сервер работает без него, просто медленнее
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# строка REDIS_URL перебивает поля выше
REDIS_URL=
CACHE_ENABLED=true

# миграции
# накатанный файл миграции править нельзя, сервер это заметит по контрольной сумме
# и откажется мигрировать, флаг ниже разрешает расхождение, если оно осознанное
MIGRATIONS_ALLOW_CHECKSUM_DRIFT=false

# https без домена
# сервер сам делает самоподписанный сертификат и слушает его на 4443
# приложение доверяет такому сертификату по отпечатку, домен и Let's Encrypt не нужны
# порт меняется в трёх местах сразу: тут, в Caddyfile и в docker-compose.yml
# параметры SERVER_PUBLIC_IP и TLS_SANS нужны, если сервер за натом не видит себя снаружи
TLS_PORT=4443
SERVER_PUBLIC_IP=
TLS_SANS=

# домен и обратный прокси с https
# caddy поднимается вместе с docker compose и слушает порты 80 и 443
# домен SERVER_DOMAIN можно оставить пустым: сперва подключиться по ip,
# а домен потом задать прямо из приложения reSchool
# у домена уже должна быть A запись на этот сервер,
# а порты 80 и 443 должны быть видны из интернета
SERVER_DOMAIN=

# публичный адрес, на него ведут кнопки из телеграма
# необязательный: если пусто, server_advanced возьмёт домен из приложения
# или соберёт адрес из SERVER_DOMAIN
# пример значения: https://reschool.app
PUBLIC_BASE_URL=

# токен, который клиенты шлют в заголовке авторизации
API_TOKEN=

# включаем только при локальной отладке, в полных логах видны пароли и токены
DEBUG_REQUEST_LOG_FULL=false

# ключ шифрования паролей, формат fernet
# сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CF3_ENCRYPTION_KEY=

# разбор учебников и домашнего задания нейросетью
AI_PROVIDER=google
# для openrouter задаём AI_PROVIDER=openrouter и ключ
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_TIMEOUT_SECONDS=900
# вариант через vertex ai: авторизация берётся из gcloud, квоты боевые
GEMINI_VERTEX_PROJECT=
GEMINI_VERTEX_LOCATION=global
# вариант Google через ключ AI Studio (если проект Vertex AI не задан)
GEMINI_API_KEY=
# лайты возвращают обрезанные координаты заданий, модель тут не понижаем
GEMINI_MODEL=gemini-3.8-flash
# разбор целиком можно выключить, пуши тогда уходят как раньше
ANALYSIS_ENABLED=true
# сколько ждём разбор, прежде чем сохранить уведомление без него
ANALYSIS_NOTIFICATION_TIMEOUT_SECONDS=300
# страниц в одном запросе при индексации учебника
TEXTBOOK_INDEX_CHUNK=16

# браузер подключается по WebRTC; личному серверу не нужен публичный сертификат
# мост запускаем через docker compose с файлами docker-compose.yml и docker-compose.browser.yml
BROWSER_SIGNAL_URL=wss://reschool.app/signal
# обычный адрес сервера, используется в коде подключения; либо задайте PUBLIC_BASE_URL
BROWSER_SERVER_URL=
